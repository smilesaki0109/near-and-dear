# Copy to .env.local and paste values from your Supabase project (Settings → API).
# Phase 1 only checks that the client can be created; browsing uses local mock data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
